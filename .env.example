# ---------- Database ----------
# PostgreSQL connection string supplied by the business owner.
DATABASE_URL="postgresql://user:password@localhost:5432/krishna_garments?schema=public"

# ---------- Owner authentication ----------
# NEVER commit real values. These are read server-side only and are hashed with
# Argon2id into the database by `npm run setup:owner`.
OWNER_USERNAME=
OWNER_PASSWORD=

# Session signing secret. Generate with:  openssl rand -base64 48
SESSION_SECRET=

# Set to "true" in development to allow the sample-data seed to write records.
SAMPLE_DATA=true

# ---------- Business details (fill in) ----------
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_BUSINESS_EMAIL=info@krishnagarments.example
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- EmailJS Configuration (Customer Authentication & OTP) ----------
# Service ID from EmailJS Dashboard (e.g., service_xxxxxxx)
EMAILJS_SERVICE_ID=
# Krishna Garments EmailJS OTP Template ID
EMAILJS_TEMPLATE_ID=template_uhqx4oa
# EmailJS Public Key (Account > API Keys)
EMAILJS_PUBLIC_KEY=
# EmailJS Private Key / Access Token (Account > API Keys > Private Key)
EMAILJS_PRIVATE_KEY=

# ---------- Hero frame extraction (build-time only) ----------
# Absolute path to the supplied garment-manufacturing video.
HERO_VIDEO_PATH=
# Number of frames to sample from the source clip (default 160; 239 = every frame).
HERO_FRAME_COUNT=239
