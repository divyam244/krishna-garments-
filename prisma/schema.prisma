// KRISHNA GARMENTS — data model
//
// Covers the public storefront catalogue, customer/wholesale enquiries, cart,
// and the full owner business panel (orders, inventory, production, payments,
// customers, suppliers, reports, settings).
//
// Sample data is isolated via `isSample` so it can be identified in the UI and
// purged without touching real business records.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductAvailability {
  IN_STOCK
  LOW_STOCK
  MADE_TO_ORDER
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PRODUCTION
  PACKED
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

enum BatchStage {
  CUTTING
  STITCHING
  FINISHING
  QUALITY_CHECK
  PACKAGING
  COMPLETE
}

enum EnquiryType {
  WHOLESALE
  BULK_ORDER
  CUSTOM_STITCHING
  MANUFACTURING
  GENERAL
}

enum EnquiryStatus {
  NEW
  REVIEWING
  QUOTED
  CONVERTED
  CLOSED
}

// ---------------------------------------------------------------- Catalogue ---

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  tagline     String?
  image       String?
  sortOrder   Int       @default(0)
  showInNav   Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Collection {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  image       String?
  season      String?
  sortOrder   Int       @default(0)
  published   Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id            String    @id @default(cuid())
  sku           String    @unique
  slug          String    @unique
  name          String
  description   String
  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  collectionId  String?
  collection    Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  images        Json      @default("[]") // ordered list of gallery image paths
  fabric        String? // material information
  sizes         Json      @default("[]") // ["S","M","L",...]
  colours       Json      @default("[]") // [{name, hex}]
  price         Decimal?  @db.Decimal(12, 2) // null => wholesale enquiry only
  mrp           Decimal?  @db.Decimal(12, 2)
  currency      String    @default("INR")
  priceOnRequest Boolean @default(false)
  availability  ProductAvailability @default(IN_STOCK)
  isNewArrival  Boolean   @default(false)
  isFeatured    Boolean   @default(false)
  onSale        Boolean   @default(false)
  stockOnHand   Int       @default(0)
  minOrderQty   Int       @default(1)
  rating        Decimal?  @db.Decimal(3, 2)
  viewCount     Int       @default(0)
  isSample      Boolean   @default(false)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orderItems    OrderItem[]
  stockLedger   StockMovement[]

  @@index([categoryId])
  @@index([collectionId])
  @@index([isNewArrival, isFeatured])
  @@index([availability, active])
}

// ------------------------------------------------------------ Shopper cart ---

/// Server-side cart so the bag survives reloads and works across devices.
model CartSession {
  id        String      @id @default(cuid())
  token     String      @unique
  items     CartItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model CartItem {
  id        String      @id @default(cuid())
  cartId    String
  cart      CartSession @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  size      String
  colour    String?
  quantity  Int         @default(1)

  @@unique([cartId, productId, size, colour])
}

// ------------------------------------------------------------- Business ops ---

model Customer {
  id          String    @id @default(cuid())
  name        String
  company     String?
  email       String?
  phone       String?
  address     String?
  city        String?
  gstin       String?
  type        String    @default("RETAIL") // RETAIL | WHOLESALE | BULK
  notes       String?
  orders      Order[]
  payments    Payment[]
  enquiries   Enquiry[]
  isSample    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Supplier {
  id          String    @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  supplies    String? // Fabric | Trims | Packaging | Machines
  leadTimeDays Int?
  outstanding Decimal?  @db.Decimal(12, 2)
  notes       String?
  purchases   Purchase[]
  isSample    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Order {
  id            String      @id @default(cuid())
  orderNo       String      @unique
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String
  status        OrderStatus @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  channel       String      @default("ONLINE") // ONLINE | WHOLESALE | CUSTOM
  subtotal      Decimal     @db.Decimal(12, 2)
  shipping      Decimal     @default(0) @db.Decimal(12, 2)
  discount      Decimal     @default(0) @db.Decimal(12, 2)
  total         Decimal     @db.Decimal(12, 2)
  paidAmount    Decimal     @default(0) @db.Decimal(12, 2)
  dueDate       DateTime?
  batchId       String?
  batch         ProductionBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  notes         String?
  items         OrderItem[]
  payments      Payment[]
  isSample      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  label     String // snapshot name, survives product deletion
  size      String?
  colour    String?
  unitPrice Decimal @db.Decimal(12, 2)
  quantity  Int
  lineTotal Decimal @db.Decimal(12, 2)
}

model Payment {
  id        String        @id @default(cuid())
  receiptNo String        @unique
  orderId   String?
  order     Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerId String?
  customer  Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  amount    Decimal       @db.Decimal(12, 2)
  method    String        @default("BANK") // BANK | UPI | CASH | CARD
  status    PaymentStatus @default(PARTIAL)
  recordedAt DateTime     @default(now())
  dueAfterDays Int?
  isSample  Boolean       @default(false)
}

model ProductionBatch {
  id          String      @id @default(cuid())
  batchNo     String      @unique
  productName String
  productId   String?
  targetQty   Int
  completedQty Int        @default(0)
  stage       BatchStage  @default(CUTTING)
  progressPct Int         @default(0)
  startDate   DateTime    @default(now())
  expectedDate DateTime?
  inCharge    String?
  notes       String?
  orders      Order[]
  movements   StockMovement[]
  isSample    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model StockMovement {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchId   String?
  batch     ProductionBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  type      String // IN | OUT | ADJUST
  quantity  Int // signed: +in / -out
  reason    String?
  createdAt DateTime        @default(now())

  @@index([productId, createdAt])
}

model Purchase {
  id         String   @id @default(cuid())
  invoiceNo  String   @unique
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  item       String
  quantity   Int
  amount     Decimal  @db.Decimal(12, 2)
  status     String   @default("OPEN") // OPEN | PAID
  purchaseDate DateTime @default(now())
  isSample   Boolean  @default(false)
}

// ---------------------------------------------------------------- Enquiries ---

model Enquiry {
  id           String        @id @default(cuid())
  reference    String        @unique
  type         EnquiryType
  status       EnquiryStatus @default(NEW)
  name         String
  businessName String?
  phone        String
  email        String?
  products     String?
  quantity     String?
  message      String?
  city         String?
  customerId   String?
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  ipHash       String?
  handledBy    String?
  reply        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([type, status])
}

/// Newsletter signups from the footer (section 12).
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("footer")
  createdAt DateTime @default(now())
}

// -------------------------------------------------------------- Owner auth ---

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String // Argon2id, never plaintext
  displayName  String
  role         String    @default("OWNER") // OWNER | STAFF
  mustChangePassword Boolean @default(false)
  lastLoginAt  DateTime?
  failedCount  Int       @default(0)
  lockedUntil  DateTime?
  sessions     Session[]
  auditLogs    AuditLog[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Opaque bearer tokens only — the raw token is never stored, just its SHA-256.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model RateLimitBucket {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(1)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
